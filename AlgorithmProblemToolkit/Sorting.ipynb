   "source": [
    "numbers = [7, 2, 9, 1, 5]\n",
    "\n",
    "for i in range(len(numbers)-1):\n",
    "    for j in range(len(numbers)-1-i):\n",
    "        if numbers[j]>numbers[j+1]:\n",
    "            numbers[j],numbers[j+1]=numbers[j+1],numbers[j]\n",
    "\n",
    "print(numbers)"
   ]
  }
